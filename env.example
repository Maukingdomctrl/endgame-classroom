# Copy this file to .env.local and fill in values
# .env.local is gitignored — never commit real secrets

# Base URL for the sync server (Board Editor save endpoint)
# Leave empty to disable server sync
VITE_SYNC_SERVER_URL=

# Optional: override the public path for Stockfish WASM assets
# Defaults to /stockfish.js in the public folder
VITE_STOCKFISH_PATH=/stockfish.js
